# Copy this file to ../.env.k8s, replace both CHANGE_ME values.
# Do NOT use quotes; do NOT commit .env.k8s to Git.
# Keep POSTGRES_PASSWORD URL-safe (e.g. a random hex string) because the
# Kubernetes manifest builds DATABASE_URL from this password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX_PASSWORD
POSTGRES_DB=pcbuilder
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_SECRET
